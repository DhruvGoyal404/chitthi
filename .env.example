# Copy to .env and fill in. .env is git-ignored; never commit it.
# compose.yaml, dbmate (npm run db:migrate) and the API (npm run dev:api) all read this file.

# Postgres (compose.yaml). Pick any local password, and use the same one in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# API
NODE_ENV=development
HOST=127.0.0.1
PORT=8082
DATABASE_URL=postgres://chitthi:change-me@127.0.0.1:5435/chitthi?sslmode=disable
LOG_LEVEL=info
# Comma-separated origins allowed to send state-changing requests and open WebSockets.
WEB_ORIGINS=http://localhost:5175
# Development sign-in shortcut (sign in as any handle, no password). Refused unless
# NODE_ENV is development or test.
DEV_LOGIN=true
