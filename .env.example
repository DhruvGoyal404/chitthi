# Copy to .env and fill in. .env is git-ignored; never commit it.
# compose.yaml, dbmate (npm run db:migrate), scripts and the API (npm run dev:api) all read this file.

# Postgres owner (compose.yaml). Pick any local password; use it in MIGRATION_DATABASE_URL and TEST_DATABASE_URL.
POSTGRES_PASSWORD=change-me

# API
NODE_ENV=development
HOST=127.0.0.1
PORT=8082
# The API logs in as chitthi_api: a member of chitthi_app and nothing else (created by the
# migrations). Pick its password here (16+ characters), then run `npm run db:api-password`.
DATABASE_URL=postgres://chitthi_api:change-me-api-password@127.0.0.1:5435/chitthi?sslmode=disable
# Owner credentials: migrations (npm run db:migrate) and setting the API password only.
MIGRATION_DATABASE_URL=postgres://chitthi:change-me@127.0.0.1:5435/chitthi?sslmode=disable
LOG_LEVEL=info
# Comma-separated origins allowed to send state-changing requests and open WebSockets.
WEB_ORIGINS=http://localhost:5175
# Development sign-in shortcut (sign in as any handle, no password). Refused unless
# NODE_ENV is development or test.
DEV_LOGIN=true

# Tests (npm test): owner credentials on the same cluster. The test run creates and migrates its
# own databases (chitthi_test, chitthi_schema_roundtrip) and never touches DATABASE_URL's database.
TEST_DATABASE_URL=postgres://chitthi:change-me@127.0.0.1:5435/chitthi?sslmode=disable
# The same API login the app uses (tests run every app query as chitthi_api).
TEST_API_DATABASE_URL=postgres://chitthi_api:change-me-api-password@127.0.0.1:5435/chitthi?sslmode=disable

# Public origin of the web app (OAuth redirect URIs are built from it) and how many reverse-proxy
# hops to trust for the client IP: 0 when the API is reached directly, 1 behind exactly one proxy
# (e.g. Caddy). PUBLIC_ORIGIN must be one of WEB_ORIGINS; it defaults to the first of them.
PUBLIC_ORIGIN=http://localhost:5175
TRUST_PROXY=0

# Real sign-in. These may live here or in api/.env (also git-ignored; the API reads both, api/.env
# last). Leave a pair empty to hide that provider. Redirect URIs to register with each provider:
#   <PUBLIC_ORIGIN>/api/auth/google/callback  and  <PUBLIC_ORIGIN>/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Uploaded media (local filesystem driver). Absolute path, outside any web root; required in
# production. Defaults to <repo>/.data/media (git-ignored) in development and tests.
# MEDIA_DIR=/var/lib/chitthi/media

# Development only: loosen the disk guard. The API refuses new uploads when the drive holding
# MEDIA_DIR has less than max(15 %, 2 GB) free; on a fuller dev drive, lower it here. The API
# refuses to start if either is set with NODE_ENV=production, where the rule is fixed.
MEDIA_MIN_FREE_PERCENT=5
MEDIA_MIN_FREE_BYTES=1073741824

# Image processing (sharp). Leave unset in development. A small production VM tightens them: fewer
# images decoded at once, a lower pixel limit, sharp's cache off. They can never be loosened past
# the defaults (2, 50000000, true).
# IMAGE_CONCURRENCY=1
# IMAGE_MAX_PIXELS=24000000
# IMAGE_CACHE=false
